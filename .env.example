# --- Research & Ecosystem APIs ---
GITHUB_PAT=
HUGGINGFACE_TOKEN=
SEC_USER_AGENT=UrivalentResearch/1.0 (contact@urivalent.com)

# --- Targeted News APIs (Free Tiers) ---
GNEWS_API_KEY=
NEWSDATA_API_KEY=
THENEWSAPI_KEY=
WORLDNEWS_API_KEY=
MEDIASTACK_API_KEY=
NEWSAPI_ORG_KEY=

# --- Telegram & Social Bridge ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
