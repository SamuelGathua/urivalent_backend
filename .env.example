# ==============================================================================
# URIVALENT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# --- App & Branding ---
TIMEZONE=Africa/Nairobi
LOGO_URL=/assets/urivalent_logo.jfif
JWT_SECRET_KEY=change_me_super_secret_urivalent_jwt_key_2026
